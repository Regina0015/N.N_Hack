# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Exact model IDs from the Token Factory catalog
# Coach (text): an NVIDIA Nemotron model, e.g. Nemotron 3 Super
COACH_MODEL=
# Food photos (vision): e.g. Nemotron Nano 2 VL
VISION_MODEL=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
