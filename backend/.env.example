# Copy this file to `.env` and fill in the values. Never commit `.env`.

# Nebius Token Factory (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Exact model IDs from the Token Factory catalog
# Coach (text): exact ID, e.g. nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B (list them with client.models.list())
COACH_MODEL=
# Food photos (vision): e.g. Nemotron Nano 2 VL
VISION_MODEL=

# Database. Empty → local SQLite file (backend/data/dev.db).
# Supabase: Connect → "Session pooler" URI (IPv4, port 5432, user postgres.<project-ref>).
# Replace [YOUR-PASSWORD]; URL-encode special characters (e.g. @ → %40).
DATABASE_URL=

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000
